# Starting configuration: 4 app instances x 4 CPU x 8 GB RAM.

APP_REPLICAS=4
APP_CPUS=4
APP_MEM=8g

DB_CPUS=4
DB_MEM=4g
DB_MAX_CONNECTIONS=250

# Host-side published ports (change if 5432 / 8080 are already in use locally).
DB_PUBLISH_PORT=5432
LB_PUBLISH_PORT=8080

# Application / datasource tuning knobs (SOLUTION values).
HIKARI_MAX_POOL=15
HIKARI_MIN_IDLE=5
CLASSIFY_LATENCY_MS=8
CACHE_TYPE=caffeine

# Diagnostics
SHOW_SQL=false
SQL_LOG_LEVEL=INFO
HIBERNATE_STATS=false

# Credentials / dataset
DB_NAME=taxdb
DB_USER=tax
DB_PASSWORD=tax
SEED_CITIES=1000
SEED_VERSIONS=6
SEED_CUSTOMERS=500000
SEED_TRANSACTIONS=5000000
