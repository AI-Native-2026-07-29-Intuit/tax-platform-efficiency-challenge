# Reduced-infrastructure configuration: 2 app instances x 2 CPU x 4 GB RAM.
# Run:
#
#   docker compose --env-file .env.cost-cut up -d
#
# Target at this size: 800+ rps, P95 < 500ms, correct tax results.

APP_REPLICAS=2
APP_CPUS=2
APP_MEM=4g

DB_CPUS=2
DB_MEM=4g
DB_MAX_CONNECTIONS=250

HIKARI_MAX_POOL=15
HIKARI_MIN_IDLE=5
CLASSIFY_LATENCY_MS=8
CACHE_TYPE=caffeine

SHOW_SQL=false
SQL_LOG_LEVEL=INFO
HIBERNATE_STATS=false

DB_NAME=taxdb
DB_USER=tax
DB_PASSWORD=tax
SEED_CITIES=1000
SEED_VERSIONS=6
SEED_CUSTOMERS=500000
SEED_TRANSACTIONS=5000000
